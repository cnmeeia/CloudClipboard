# CloudClipboard Worker 本地开发环境变量
# 复制为 .dev.vars（已被 gitignore）
# 生产使用: wrangler secret put

# 登录验证已全部移除；生产环境由边缘 Zero Trust 注入邮箱身份头。
# 本地开发可设置兜底邮箱（可选），用于派生稳定的 userId。
CF_ACCESS_DEV_EMAIL=dev@example.com

# 生产环境强烈建议配置以下两项，用于校验 Cf-Access-Jwt-Assertion 的签名，
# 防止绕过 Access（如 workers.dev 子域名未关闭时）直接伪造邮箱头冒充用户。
# 一旦配置，Worker 会拒绝所有未通过 JWT 验证的请求（不再信任裸邮箱头）。
# CF_ACCESS_AUD="<Zero Trust → Access → 应用 → Application Audience (AUD) Tag>"
# CF_ACCESS_TEAM_DOMAIN="<你的 team 名，对应 https://<team>.cloudflareaccess.com>"

# 生产强制 JWT 校验开关（fail-closed）。设 "true" 时，即使未配置上面两项也会拒绝
# 所有请求（防止上线时忘配导致洞未补）。本地开发无需设置。
# FORCE_ACCESS_JWT=true

ENCRYPTION_VERSION=2
