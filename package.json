{
  "name": "cloudclipboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CloudClipboard - Personal Universal Clipboard · PWA + Bark + E2EE + Cloudflare",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cloudclipboard/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "deploy": "pnpm --filter @cloudclipboard/web run build && pnpm --filter @cloudclipboard/worker run deploy",
    "deploy:full": "pnpm typecheck && pnpm --filter @cloudclipboard/worker db:migrate && pnpm --filter @cloudclipboard/web run build && pnpm --filter @cloudclipboard/worker run deploy",
    "db:migrate": "pnpm --filter @cloudclipboard/worker db:migrate",
    "db:migrate:local": "pnpm --filter @cloudclipboard/worker db:migrate:local",
    "dev:worker": "pnpm --filter @cloudclipboard/worker dev",
    "e2ee:push": "node scripts/e2ee-push.mjs",
    "polish": "node scripts/polish-runner.js",
    "regression": "node scripts/regression-runner.js",
    "audit": "node scripts/full-audit.js",
    "polish:ci": "node scripts/full-audit.js"
  },
  "devDependencies": {
    "pixelmatch": "^5.3.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3"
  }
}
